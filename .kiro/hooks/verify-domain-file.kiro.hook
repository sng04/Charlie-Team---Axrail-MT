{
  "enabled": true,
  "name": "Domain Verification Regression Check",
  "description": "After any shell command execution, checks if the command was a deployment (s3 sync, cdk deploy, or frontend deploy) and reminds the agent to verify the domain verification file still exists and is correctly served.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the tool that just executed was a deployment command (e.g., aws s3 sync, cdk deploy, deploy_frontend.sh, or any S3/CloudFront operation), run: python3 scripts/verify_domain_verification.py --stability-rounds 3 to confirm the domain verification file at /.well-known/aws/securityagent-domain-verification.json was not deleted or overwritten. If verification fails, alert the user immediately."
  }
}